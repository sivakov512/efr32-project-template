# Environment
.envrc
.venv/
__pycache__/
*.pyc

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Build system
.cache
build
compile_commands.json

# Logs and dumps
*.core
*.dmp
*.log

# Simplicity SDK / SLC
# Machine specific toolchain paths under ~/.silabs/slt/installs. The file's own
# header says it "should not be tracked in source control".
cmake_*/autogen_toolchain.cmake

# Simplicity Studio per-user UI state (recent files, tool shortcuts) with an
# absolute path to the checkout. Regenerated by Studio on demand.
.projectlinkstore

# Simplicity Studio component editor state and the bin it moves your
# overwritten edits into. Both are per-user and recreated on demand.
.uceditor/
trashed_modified_files/

# Output of the post-build generator (empty in this project for now).
artifact/

# Generated by `make zed-debug-config` with machine specific absolute paths.
.zed/debug.json
